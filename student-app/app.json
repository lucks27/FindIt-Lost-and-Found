{
    "expo": {
        "name": "FindIt",
        "slug": "student-app",
        "version": "1.0.0",
        "platforms": ["ios", "android", "web"],
        "assetBundlePatterns": ["**/*"],
        "orientation": "portrait",
        "android": {
            "package": "com.findit.studentapp",
            "permissions": ["NOTIFICATIONS"]
        },
        "ios": {
            "bundleIdentifier": "com.findit.studentapp",
            "supportsTablet": false
        },
        "notification": {
            "icon": "./assets/logo.png",
            "color": "#198754",
            "androidMode": "default",
            "androidCollapsedTitle": "FindIt"
        },
        "plugins": [
            "expo-secure-store",
            "expo-sharing",
            [
                "expo-notifications",
                {
                    "icon": "./assets/logo.png",
                    "color": "#198754",
                    "defaultChannel": "default"
                }
            ]
        ]
    }
}
